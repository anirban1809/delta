// Feature 10 — User-defined record types (`type`)
// Spec: §8 Type Declarations, Phase K
//
// Three RHS forms: record literal, alias, and spread/intersection composition.
// Object literals carry shape but no name — the analyzer PINS their record type
// from the surrounding typed context (binding annotation / param type / return type).
//
// Pipeline work:
//   parser     : `type` decl; the anonymous `{ f: T; ... }` object-type is legal
//                ONLY on a `type` RHS; object-literal expressions `{ f: v }`.
//   semantics  : object-literal pinning by expected type; member access;
//                field-assignment L-values; WHOLE-VALUE definite assignment;
//                declaration-time cycle detection; derived structural `==`/`!=`.
//   codegen    : each record -> C struct `delta__<Name>`; compound-literal init.

type Vec3 = { x: float64; y: float64; z: float64; };   // record
type Position = Vec3;                                   // alias
type Animal = { legs: int32; sound: int32; };
type Dog = { ...Animal; goodBoy: bool; };               // spread composition
type Cat = Animal & { indoor: bool; };                  // intersection composition

function main(): int32 {
    const origin: Vec3 = { x: 0.0, y: 0.0, z: 0.0 };   // object literal pinned by annotation
    let p: Position = { x: 1.0, y: 2.0, z: 3.0 };

    const px: float64 = p.x;        // member access
    p.x = 10.0;                     // field assignment (p is a mutable, initialized `let`)

    const rex: Dog = { legs: 4, sound: 1, goodBoy: true };
    const same: bool = (origin == origin);   // compiler-derived structural equality

    // let q: Vec3;
    // q.x = 1.0;                   // ERROR: partial initialization — assign the whole value first
    // const bad: Vec3 = { x: 0.0 };// ERROR: missing fields `y`, `z` for `Vec3`
    // const n = origin.w;          // ERROR: `Vec3` has no field `w`
    // type Loop = { self: Loop; }; // ERROR: recursive record requires indirection (`heap<T>`, feature 14)

    if (same && rex.goodBoy) {
        return int32(px);
    }
    return 0;
}

/* === Generated C (illustrative) ===
   Each record -> `struct delta__<Name>` in field-declaration order. An alias
   emits no new struct (reuses the aliased name). Object literals -> C compound
   literals. Structural `==` -> a generated per-type equality function.
#include <stdbool.h>
#include <stdint.h>

typedef struct { double x; double y; double z; } delta__Vec3;
// Position is an alias -> reuses delta__Vec3, no new type emitted.
typedef struct { int32_t legs; int32_t sound; } delta__Animal;
typedef struct { int32_t legs; int32_t sound; bool goodBoy; } delta__Dog;   // spread
typedef struct { int32_t legs; int32_t sound; bool indoor; } delta__Cat;    // intersection

static bool delta__Vec3__eq(delta__Vec3 a, delta__Vec3 b) {
    return a.x == b.x && a.y == b.y && a.z == b.z;
}

int32_t main(void) {
    const delta__Vec3 origin = (delta__Vec3){ .x = 0.0, .y = 0.0, .z = 0.0 };
    delta__Vec3 p = (delta__Vec3){ .x = 1.0, .y = 2.0, .z = 3.0 };
    const double px = p.x;                 // member access
    p.x = 10.0;                            // field assignment
    const delta__Dog rex = (delta__Dog){ .legs = 4, .sound = 1, .goodBoy = true };
    const bool same = delta__Vec3__eq(origin, origin);
    if (same && rex.goodBoy) { return (int32_t)px; }
    return 0;
}
*/
