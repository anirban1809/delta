// Feature 16 — Receiver methods on records
// Spec: §9.5 (reused for records), Phase L
//
// A `type` record gets behavior via top-level functions with a RECEIVER clause:
//   function (r: &T) m(...): R { ... }       // read-only receiver (r behaves as &T)
//   function (r: edit &T) m(...): R { ... }  // mutable receiver  (r behaves as edit &T)
// Call form is `value.m(args)` with auto-referencing of the receiver. Capability
// dispatch: a `const` binding (or `&T`) may NOT call an `edit`-receiver method.
// There is no by-value receiver. Methods travel with the type across modules.
//
// Pipeline work:
//   parser     : receiver clause via `function (` lookahead (vs `function NAME(`);
//                a `ReceiverParam` whose type is `&T`/`edit &T` to a record.
//   semantics  : resolve `x.m()` to a method of x's record type (through refs/heap
//                auto-deref); capability check (const/`&` can't call `edit` methods);
//                method name may not collide with a field name.
//   codegen    : `x.m(args)` -> `delta__T_m(&x, args)`; body `r.field` -> `r->field`.

// `value` is heap-backed so Counter is cloneable (non-copyable) and `move` /
// `edit` are meaningful — see feature 12's note.
type Counter = { value: heap<int64>; };

function (c: &Counter) get(): int64 {
    return c.value;                          // heap auto-deref
}

function (c: edit &Counter) add(amount: int64): void {
    c.value = c.value + amount;
}

function main(): uint8 {
    let c: Counter = { value: new 0 };

    c.add(5);                  // OK — `c` is a `let`, may call an `edit`-receiver method
    c.add(7);
    const total: int64 = c.get();   // OK — read-receiver method

    // const frozen: Counter = { value: new 0 };
    // frozen.add(1);          // ERROR: cannot call `edit`-receiver method on `const` binding

    return uint8(total);
}

/* === Generated C (illustrative) ===
   A receiver method lowers to a free function taking the receiver as a pointer:
   `&T` receiver -> `const T*`, `edit &T` receiver -> `T*`. `x.m(args)` lowers to
   `delta__T__m(&x, args)`. Capability dispatch (const can't call edit methods) is
   compile-time; the C is the same address-of.
#include <stdint.h>

typedef struct { int64_t* value; } delta__Counter;        // heap<int64> -> int64*

int64_t delta__Counter__get(const delta__Counter* c) {
    return *c->value;                                     // heap auto-deref
}
void delta__Counter__add(delta__Counter* c, int64_t amount) {
    *c->value = delta_add_i64(*c->value, amount);
}

int32_t main(void) {
    delta__Counter c = { .value = delta_rt_box_i64(0) };
    delta__Counter__add(&c, 5);          // c.add(5)
    delta__Counter__add(&c, 7);
    const int64_t total = delta__Counter__get(&c);   // c.get()
    delta_rt_free(c.value);
    return (int32_t)total;
}
*/
