// Feature 01 — Local variable bindings (`let` / `const`)
// Spec: §3.3 Variable Bindings and Definite Assignment
//
// Pipeline work this unlocks:
//   parser     : `let`/`const` statement (name, optional annotation, initializer)
//                and an identifier as an expression kind.
//   semantics  : block-scoped symbol table; NAME RESOLUTION turns on here;
//                use-of-undeclared-name error; initializer assignability.
//   codegen    : emit `int32_t x = 0;` then reference `x`.
//   diagnostics: "undeclared variable", "type mismatch in initializer".
//   lsp        : hover + go-to-definition on a LOCAL (scoped lookup).

function main(): int8 {
    const max: int32 = 100;     // OK — const requires an initializer
    let total: int32 = 0;       // OK — mutable binding
    total = max;                // (assignment lands in feature 05)

    // let min: int32;        // ERROR: const declaration requires an initializer
    // return missing;          // ERROR: use of undeclared name `missing`
    // const bad: int32 = true; // ERROR: type mismatch: expected `int32`, found `bool`

    return int8(total);
}

