// Feature 05 — Assignment, compound assignment, mutability
// Spec: §11 Mutability Model (const vs let)
//
// `const` is read-only: cannot be reassigned, mutated through, passed as `edit &`,
// or moved from. `let` is reassignable. This is your first binding-state tracking.
//
// Pipeline work:
//   parser     : assignment statement `x = e;`, compound `+= -= *=`, postfix `i++`/`i--`.
//   semantics  : reject assignment to a `const`; assignment RHS must match the
//                binding type; compound ops + `++` require an integer `let`.
//   codegen    : compound ops and `++` lower to the overflow-checked helpers (feature 06).

function main(): int8 {
    let total: int32 = 0;
    const step: int32 = 5;

    total = step;        // OK — reassign a `let`
    total += step;       // OK — compound assignment
    total *= 2;          // OK
    total++;             // OK — postfix increment (yields pre-update value, traps on overflow)

    // step = 10;        // ERROR: cannot assign to `const` binding `step`
    // step++;           // ERROR: cannot mutate `const` binding `step`
    // total = true;     // ERROR: type mismatch: expected `int32`, found `bool`

    return int8(total);
}

/* === Generated C (illustrative) ===
   `const` vs `let` is a compile-time capability check; both lower to C values
   (a `const` binding may emit C `const`). Compound ops and `++` route through
   the trapping helpers from feature 06.
#include <stdint.h>

int32_t main(void) {
    int32_t total = 0;
    const int32_t step = 5;
    total = step;                          // =
    total = delta_add_i32(total, step);    // +=
    total = delta_mul_i32(total, 2);       // *=
    total = delta_add_i32(total, 1);       // ++ (post-value unused here)
    return total;
}
