// Feature 03 — Primitive numeric type set + explicit casts
// Spec: §5.1 Type Set and Naming, §3.8 conversions
//
// The 11 numeric types (verbose `type+width` naming — no `i32`/`u32`/`f64` aliases):
//   signed   : int8  int16  int32  int64  intsize
//   unsigned : uint8 uint16 uint32 uint64 uintsize
//   floats   : float32 float64
// (intsize/uintsize are pointer-width.)
//
// Hard rule: NO implicit conversion across width or signedness. Every cross-type
// conversion is a call-style cast `int64(x)`, and narrowing/sign-flip casts TRAP
// at runtime when the value does not fit (ties into feature 06).
//
// Pipeline work:
//   semantics  : a real type table for the 11 primitives; reject implicit
//                conversions; recognize `T(x)` casts; classify which casts can trap.
//   codegen    : map int32->int32_t, uint8->uint8_t, float64->double, etc.;
//                emit checked-narrowing helpers for fallible casts.

function main(): int32 {
    const small: int32  = 10;
    const big: int64    = int64(small);    // OK — explicit widening
    const back: int32   = int32(big);      // OK — explicit narrowing (may trap)
    const u: uint32     = uint32(small);   // OK if small >= 0, traps otherwise
    const f: float64    = float64(small);  // OK — explicit int -> float

    // const implicitWiden: int64 = small;     // ERROR: no implicit int32 -> int64 widening
    // const implicitSign: uint32 = small;     // ERROR: no implicit sign change
    // const implicitFloat: float64 = small;   // ERROR: no implicit int -> float promotion
    // const overflowCast: uint8 = uint8(300); // (parses) -> runtime trap: value out of range for uint8

    return int32(f) + back + int32(u);
}

/* === Generated C (illustrative) ===
   Widening / int->float casts are plain C casts (always safe). Narrowing and
   sign-flipping casts go through checked helpers that trap when out of range.
#include <stdint.h>

int32_t main(void) {
    const int32_t  small = 10;
    const int64_t  big  = (int64_t)small;                 // widening: plain cast
    const int32_t  back = delta_cast_i64_to_i32(big);     // narrowing: checked, may trap
    const uint32_t u    = delta_cast_i32_to_u32(small);   // sign-flip: checked, may trap
    const double   f    = (double)small;                  // int -> float: plain cast
    return delta_cast_f64_to_i32(f) + back + (int32_t)u;  // float -> int: checked
}
*/
