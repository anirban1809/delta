#include <stdint.h>

int32_t main(void) {
    const int32_t a = 6;
    const int32_t b = 4;
    const int32_t sum  = a + b;        // -> delta_add_i32(a, b)  (feature 06)
    const int32_t diff = a - b;        // -> delta_sub_i32(a, b)
    const int32_t prod = a * b;        // -> delta_mul_i32(a, b)
    const int32_t quot = a / b;        // -> delta_div_i32(a, b)
    const int32_t rem  = a % b;        // -> delta_rem_i32(a, b)
    const int32_t masked  = a & b;     // bitwise: no trap, plain op
    const int32_t shifted = a << 1;    // -> delta_shl_i32(a, 1)
    const bool isBigger = a > b;       // comparisons/logical: plain, no trap
    const bool both = isBigger && (a != b);
    const bool negated = !both;
    const int32_t grouped = (a + b) * 2;
    (void)negated;
    return sum + diff + prod + quot + rem + masked + shifted + grouped;
}
*/
