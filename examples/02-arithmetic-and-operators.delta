// Feature 02 — Binary & unary operators
// Spec: §3 (operator set), §5.4 (shift semantics)
//
// Pipeline work:
//   parser     : binary expressions at C precedence
//                (* / %  >  + -  >  << >>  >  relational  >  ==/!=  >  &  >  ^  >  |  >  &&  >  ||)
//                unary  !expr, -expr, ~expr ; parenthesized expressions.
//   semantics  : operator typing — both operands same numeric type; comparisons
//                yield bool; logical operators require bool; `!` requires bool.
//   codegen    : lower nested expression trees (arithmetic ops route through the
//                checked helpers from feature 06).

function main(): int8 {
    const a: int32 = 6;
    const b: int32 = 4;

    const sum: int32  = a + b;          // 10
    const diff: int32 = a - b;          // 2
    const prod: int32 = a * b;          // 24
    const quot: int32 = a / b;          // 1
    const rem: int32  = a % b;          // 2

    const masked: int32 = a & b;        // bitwise and
    const shifted: int32 = a << 1;      // shift

    const isBigger: bool = a > b;       // comparison -> bool
    const both: bool = isBigger && (a != b);
    const negated: bool = !both;

    const grouped: int32 = (a + b) * 2; // precedence override

    // const bad: int32 = a && b;       // ERROR: `&&` expects `bool` operands, found `int32`
    // const cmp: int32 = a > b;        // ERROR: type mismatch: expected `int32`, found `bool`

    return int8(sum + diff + prod + quot + rem + masked + shifted + grouped);
}

/* === Generated C (illustrative) ===
   At feature 02 you may emit plain C operators. Feature 06 then swaps the
   trapping ops (+ - * / % << ) for checked helpers (shown in comments).
