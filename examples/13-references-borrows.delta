// Feature 13 — Safe references (`&T` / `edit &T`)
// Spec: §12 Safe References
//
// Non-owning, non-null, call-scoped access to existing storage. `&x` makes a
// read-only reference; `edit &x` makes a mutable, EXCLUSIVE reference. The owner
// call site must write the sigil explicitly. Many readers OR one writer. Reference
// operands must be named storage (no temporaries/literals). A `const` binding can
// only produce `&T`, never `edit &T`.
//
// Pipeline work:
//   parser     : `&T` / `edit &T` parameter types; `&x` / `edit &x` argument forms.
//   semantics  : exclusivity / root-locking over the call's reference set;
//                const-binding cannot yield `edit &`; reject `&temporary`;
//                `edit &T` weakens to `&T` when forwarded.
//   codegen    : `&T` -> `const T*`, `edit &T` -> `T*`; field access through a
//                reference -> `r->field`.

type Vec3 = { x: float64; y: float64; z: float64; };

function lengthSquared(v: &Vec3): float64 {             // read-only borrow
    return v.x * v.x + v.y * v.y + v.z * v.z;
}

function scale(v: edit &Vec3, factor: float64): void {  // mutable borrow
    v.x = v.x * factor;
    v.y = v.y * factor;
    v.z = v.z * factor;
}

function main(): uint8 {
    let p: Vec3 = { x: 1.0, y: 2.0, z: 2.0 };

    const n: float64 = lengthSquared(&p);   // explicit `&` at the owner call site
    scale(edit &p, 2.0);                     // explicit `edit &`

    // lengthSquared(p);                     // ERROR: owner call site must say `&`
    // const frozen: Vec3 = { x: 0.0, y: 0.0, z: 0.0 };
    // scale(edit &frozen, 2.0);             // ERROR: `const` cannot produce an `edit &` reference
    // lengthSquared(&Vec3{ x: 0.0,... });   // ERROR: cannot reference a temporary

    return uint8(n);
}

/* === Generated C (illustrative) ===
   `&T` -> `const T*`, `edit &T` -> `T*`. The `&x` / `edit &x` argument forms are
   plain C address-of. Exclusivity is enforced at compile time only — no runtime
   trace. Field access through a reference is `r->field`.
#include <stdint.h>

typedef struct { double x; double y; double z; } delta__Vec3;

double lengthSquared(const delta__Vec3* v) {                 // &Vec3
    return v->x * v->x + v->y * v->y + v->z * v->z;
}

void scale(delta__Vec3* v, double factor) {                  // edit &Vec3
    v->x = v->x * factor;
    v->y = v->y * factor;
    v->z = v->z * factor;
}

int32_t main(void) {
    delta__Vec3 p = (delta__Vec3){ .x = 1.0, .y = 2.0, .z = 2.0 };
    const double n = lengthSquared(&p);    // `&p`
    scale(&p, 2.0);                        // `edit &p` (same C `&p`; constness differs)
    return (int32_t)n;
}
*/
