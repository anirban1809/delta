
type struct Payload = {
    value1: int32,
    value2: int32
};

type struct Holder = {
    hold: int32,
    payload1: Payload,
    payload: owned<Payload>,
    payload2: owned<Payload>
    hold2: int32
};

function allocTest(): Payload{
  const holder = new Holder {
        hold: 34, 
        payload1: Payload{value1: 34, value2: 56},
        payload: new Payload{
            value1: 69, value2: 420 
        }, 
        payload2: new Payload{
            value1: 101, value2: 202
        }, 
        hold2: 45
    };  

    const p = holder.payload1;
    return p;
}

function main(): int8 {
  allocTest();
  return 0;
}

