// Feature 11 — Recoverable error model
// Spec: §5.5, Phase C
//
// Fallible functions declare `SuccessType | Err1, Err2`. Error types ARE records
// (so feature 10 must land first). A fallible expression is consumed with
// `expr as result`, which makes its success value(s) PENDING until a matching
// `check result { ... }` block handles the error path — and every path inside
// that block must DIVERGE (return / return error as / break / continue).
// `return error as { ... }` propagates an error, the error type inferred from the
// enclosing function's declared error set.
//
// Pipeline work:
//   parser     : `T | E1, E2` signatures; `as result` binding form;
//                `check result { }`; `return error as { }`.
//   semantics  : error types resolve to records; success values pending until
//                checked; reject reading a pending value; check-block divergence;
//                reject `as result` on an infallible expression.
//   codegen    : fallible return lowers to a tagged `{ bool is_error; union{...}; }`.

type DivByZero = { numerator: int32; };

function safeDivide(a: int32, b: int32): int32 | DivByZero {
    if (b == 0) {
        return error as { numerator: a };   // error type inferred from the declared set
    }
    return a / b;                            // success value
}

function main(): int32 {
    const q = safeDivide(10, 2) as result;   // success value of `q` is pending
    check result {
        // runs only on the error path; must diverge
        return 1;
    }
    // after `check`, `q` is valid for normal use
    const doubled: int32 = q * 2;

    // const r = safeDivide(10, 0) as result;
    // return r;                 // ERROR: `r` is pending — read before its `check`

    // const ok = (1 + 1) as result;  // ERROR: this expression cannot fail

    return doubled;
}

/* === Generated C (illustrative) ===
   A fallible `T | E` return lowers to a tagged struct. `as result` captures it
   into a temporary; `check` is `if (tmp.is_error) { ...diverge... }`; reading the
   pending success value after the check is `tmp.ok`.
#include <stdbool.h>
#include <stdint.h>

typedef struct { int32_t numerator; } delta__DivByZero;

typedef struct {
    bool is_error;
    union {
        int32_t          ok;
        delta__DivByZero err;
    };
} delta__Result_i32_DivByZero;

delta__Result_i32_DivByZero safeDivide(int32_t a, int32_t b) {
    if (b == 0) {
        return (delta__Result_i32_DivByZero){
            .is_error = true, .err = { .numerator = a } };
    }
    return (delta__Result_i32_DivByZero){
        .is_error = false, .ok = delta_div_i32(a, b) };
}

int32_t main(void) {
    delta__Result_i32_DivByZero _r0 = safeDivide(10, 2);   // `as result`
    if (_r0.is_error) {                                     // `check result { ... }`
        return 1;                                           // (must diverge)
    }
    int32_t q = _r0.ok;                                     // pending -> bound
    const int32_t doubled = delta_mul_i32(q, 2);
    return doubled;
}
*/
