// Feature 14 — Heap indirection (`owned<T>`, `new`)
// Spec: §8 (heap fields), §13, Phase H
//
// `owned<T>` is a single-owner owning pointer (lowers to `T*`). Allocated with
// `new`. Bare `new` aborts on OOM; `new ... as result` yields `owned<T> | AllocError`.
// Auto-deref means `.field`/`.method()` read through the pointer transparently.
// `owned<T>` is move-only (copying the handle would alias the allocation); `clone`
// is recursive. Owner disposal frees the allocation at scope exit; field disposal
// cascades. No reference counting.
//
// `new` forms: `new T { ... }` (construct in place), `new value` (box a value),
// `new move x` (box a non-copyable binding).
//
// Pipeline work:
//   parser     : `owned<T>` type; `new T { }`, `new value`, `new move x`, `new ... as result`.
//   semantics  : owned<T> is move-only; auto-deref member access; clone is recursive;
//                scope-exit disposal frees + runs the pointee's drop.
//   codegen    : `owned<T>` -> `T*` via malloc; `x.field` -> `x->field`; free on scope exit.

type Payload = { count: int64; stride: int64; };
type BoxedCounter = { payload: heap<Payload>; };

function main(): uint8 {
    // construct the payload on the heap; handle OOM explicitly
    const bc: BoxedCounter = { payload: new Payload { count: 10, stride: 2 } as result };
    check bc {
        return 1;
    }

    const total: int64 = bc.payload.count + bc.payload.stride;  // heap auto-deref

    // `bc` goes out of scope here -> its `payload` allocation is freed automatically.

    return uint8(total);
}

