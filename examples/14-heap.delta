    // new Payload { ... } as result
    delta__Payload* _p;
    delta__Result_heapPayload_AllocError _a0 = delta_rt_alloc_Payload();
    if (_a0.is_error) { return 1; }
    _p = _a0.ok;
    *_p = (delta__Payload){ .count = 10, .stride = 2 };

    const delta__BoxedCounter bc = { .payload = _p };
    const int64_t total = bc.payload->count + bc.payload->stride;   // auto-deref

    delta_rt_free(bc.payload);             // scope-exit disposal
    return (int32_t)total;
}
*/
