// Feature 07 — `if`/`else`, `while`, C-style `for`
// Spec: §3 (control flow), Phase B
//
// Pipeline work:
//   parser     : if/else, while, C-style for(init; cond; step). Bodies REQUIRE braces.
//                `init` is a let/const decl or empty; `cond` optional bool; `step` optional expr.
//   semantics  : condition expressions must be `bool` (no truthiness); each block
//                opens a new scope.
//   codegen    : straightforward lowering to C `if`/`while`/`for`.

function classify(n: int32): int32 {
    if (n > 0) {
        return 1;
    } else if (n < 0) {
        return int32(0) - 1;
    } else {
        return 0;
    }
}

function main(): int8 {
    let sum: int32 = 0;

    // while loop
    let i: int32 = 0;
    while (i < 5) {
        sum += i;
        i++;
    }

    // C-style for loop
    for (let j: int32 = 0; j < 3; j++) {
        sum += classify(j);
    }

    // if (sum) { }          // ERROR: condition must be `bool`, found `int32`
    // while (i + 1) { }     // ERROR: condition must be `bool`, found `int32`
    // if (sum > 0) sum = 0; // ERROR: control-flow body requires braces

    return int8(sum);
}

/* === Generated C (illustrative) ===
   if/else/while/for map almost 1:1 to C. Arithmetic in conditions/steps still
   routes through the trapping helpers.
#include <stdbool.h>
#include <stdint.h>

int32_t classify(int32_t n) {
    if (n > 0)      { return 1; }
    else if (n < 0) { return delta_sub_i32(0, 1); }
    else            { return 0; }
}

int32_t main(void) {
    int32_t sum = 0;
    int32_t i = 0;
    while (i < 5) {
        sum = delta_add_i32(sum, i);
        i   = delta_add_i32(i, 1);
    }
    for (int32_t j = 0; j < 3; j = delta_add_i32(j, 1)) {
        sum = delta_add_i32(sum, classify(j));
    }
    return sum;
}
*/
