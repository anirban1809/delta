// E0603 — `check` block must diverge on every path
// Diverging terminators: `return`, `panic`, `break`, `continue`, `process.exit`,
// `unreachable`. A plain statement that falls through is rejected.
function safeAdd(a: int64, b: int64): int64 | OverflowError {
    const sum = a + b as result;
    check result { return error as OverflowError { }; }
    return sum;
}

function main(): uint8 {
    const total = safeAdd(1, 2) as result;
    check result {
        const note: int32 = 1;   // ERROR[E0603]: `check` block must diverge on every path
    }
    return int32(total);
}
