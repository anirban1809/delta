// E0607 — fallible call must be bound with `as result`
function safeAdd(a: int64, b: int64): int64 | OverflowError {
    const sum = a + b as result;
    check result { return error as OverflowError { }; }
    return sum;
}

function main(): int8 {
    const q = safeAdd(1, 2);   // ERROR[E0607]: fallible call must be bound with `as result`
    return int32(q);
}
