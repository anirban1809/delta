// E0602 — `total` is pending and cannot be used before its `check` block
function safeAdd(a: int64, b: int64): int64 | OverflowError {
    const sum = a + b as result;
    check result { return error as OverflowError { }; }
    return sum;
}

function main(): int8 {
    const total = safeAdd(1, 2) as result;
    return int32(total);   // ERROR[E0602]: `total` is pending and cannot be used before its `check` block
}
