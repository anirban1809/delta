// E12xx — Modules — SUCCESS (imported module)
// One file = one module. `export` exposes a declaration; methods travel with the type.

export type Vec3 = { x: float64; y: float64; z: float64; };

export function (v: &Vec3) lengthSquared(): float64 {
    return v.x * v.x + v.y * v.y + v.z * v.z;
}

export function add(a: &Vec3, b: &Vec3): Vec3 {
    return { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z };
}
