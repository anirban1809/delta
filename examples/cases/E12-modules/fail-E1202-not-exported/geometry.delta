// E12xx — Modules — supporting module for E1202
// `scaleInPlace` is intentionally NOT exported (module-private).

export type Vec3 = { x: float64; y: float64; z: float64; };

function scaleInPlace(v: edit &Vec3, factor: float64): void {
    v.x = v.x * factor;
    v.y = v.y * factor;
    v.z = v.z * factor;
}
