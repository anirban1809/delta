// E0804 — cannot take `edit &x` while `x` is already borrowed here
type Vec3 = { x: float64; y: float64; z: float64; };

function mix(read: &Vec3, write: edit &Vec3): void {
    write.x = read.x;
}

function main(): int8 {
    let p: Vec3 = { x: 1.0, y: 2.0, z: 3.0 };
    mix(&p, edit &p);   // ERROR[E0804]: cannot take `edit &p` while `p` is already borrowed here
    return 0;
}
