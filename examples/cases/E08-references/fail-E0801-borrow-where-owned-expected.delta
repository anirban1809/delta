// E0801 — cannot pass borrow `&p` where owned `Vec3` is expected
// Borrows cannot satisfy a by-value parameter; the fix hint suggests `clone`.
// (Replaces the old "must take the reference explicitly" message — v0.5 calls
//  auto-borrow, so an explicit sigil is never *required*.)
type Vec3 = { x: float64; y: float64; z: float64; };

function consume(v: Vec3): float64 {     // by-value (owned) parameter
    return v.x;
}

function main(): int8 {
    let p: Vec3 = { x: 1.0, y: 2.0, z: 3.0 };
    const r: float64 = consume(&p);   // ERROR[E0801]: cannot pass borrow `&p` where owned `Vec3` is expected
    return int32(r);
}
