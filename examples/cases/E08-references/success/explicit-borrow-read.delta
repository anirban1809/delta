// E08 success — an explicit `&x` read borrow (equivalent to auto-borrow).
type Vec3 = { x: float64; y: float64; z: float64; };

function lengthSquared(v: &Vec3): float64 {
    return v.x * v.x + v.y * v.y + v.z * v.z;
}

function main(): uint8 {
    let p: Vec3 = { x: 1.0, y: 2.0, z: 2.0 };
    const n: float64 = lengthSquared(&p);   // explicit &p
    return int32(n);
}
