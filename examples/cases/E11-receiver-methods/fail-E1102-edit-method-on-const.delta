// E1102 — cannot call `edit`-receiver method `add` on `const` binding `frozen`
type Counter = { value: heap<int64>; };

function (c: edit &Counter) add(amount: int64): void {
    c.value = c.value + amount;
}

function main(): int32 {
    const frozen: Counter = { value: new 0 };
    frozen.add(1);   // ERROR[E1102]: cannot call `edit`-receiver method `add` on `const` binding `frozen`
    return 0;
}
