// E07 success — `clone` deep-copies a cloneable record; the source stays live.
// Cloning a heap-owning record allocates, so it binds with `as result` (OOM).
type Counter = { value: heap<int64>; };

function main(): int32 {
    let a: Counter = { value: new 0 };
    let b = clone a as result;   // fresh allocation; `a` remains valid
    check result {
        return 1;
    }
    return 0;
}
