// E0707 — `clone` requires a cloneable type; `Token` is unique
// A `unique type` is never Cloneable — it can only be transferred with `move`.
// (Reference-bearing fields would also make a record unique, but stored borrows
//  are post-v0.5; `unique type` is the v0.5 way to declare a Unique record.)
unique type Token = { id: int32; };

function main(): int8 {
    let a: Token = { id: 1 };
    let b = clone a;   // ERROR[E0707]: `clone` requires a cloneable type; `Token` is unique
    return 0;
}
