// E09 success — a `owned<T>` field is auto-dereferenced when read, including
// through a `&` reference parameter.
type Payload = { count: int64; stride: int64; };
type BoxedCounter = { payload: heap<Payload>; };

function makeBoxedCounter(count: int64, stride: int64): BoxedCounter | AllocError {
    const p = new Payload { count: count, stride: stride } as result;
    check result {
        return error as AllocError { };
    }
    return { payload: p };
}

function total(bc: &BoxedCounter): int64 {
    return bc.payload.count + bc.payload.stride;   // auto-deref through the heap pointer
}

function main(): int8 {
    const bc = makeBoxedCounter(3, 4) as result;
    check result {
        return 1;
    }
    return int32(total(bc));   // auto-borrows &bc
}
