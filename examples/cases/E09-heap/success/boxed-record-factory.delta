// E09 success — a record with a `owned<T>` field, built by a factory that threads
// `AllocError` out via `new ... as result`. The owner is freed at scope exit.
type Payload = { count: int64; stride: int64; };
type BoxedCounter = { payload: heap<Payload>; };

function makeBoxedCounter(count: int64, stride: int64): BoxedCounter | AllocError {
    const p = new Payload { count: count, stride: stride } as result;
    check result {
        return error as AllocError { };
    }
    return { payload: p };
}

function main(): int8 {
    const bc = makeBoxedCounter(10, 2) as result;
    check result {
        return 1;
    }
    return int32(bc.payload.count + bc.payload.stride);   // auto-deref
}
