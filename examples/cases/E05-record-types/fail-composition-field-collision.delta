// Composition field collision — overlapping field names across composition
// operands are an error; there is no override (§8). No stable catalog code.
type A = { x: int32; y: int32; };
type B = { y: int32; z: int32; };
type AB = { ...A; ...B; };   // ERROR: duplicate field `y` from composition operands `A` and `B`

function main(): uint8 {
    return 0;
}
