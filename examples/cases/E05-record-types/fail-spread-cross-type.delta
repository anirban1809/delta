// Cross-type value spread — a spread source must be the SAME record type as the
// target (§8.12). No stable catalog code; Phase K structured rejection.
type Vec3 = { x: float64; y: float64; z: float64; };
type Color = { x: float64; y: float64; z: float64; };

function main(): int8 {
    const base: Color = { x: 1.0, y: 0.0, z: 0.0 };
    const v: Vec3 = { ...base };   // ERROR: spread source is `Color`, target is `Vec3`; cross-type spread is not allowed
    return int32(v.x);
}
