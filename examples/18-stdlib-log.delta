// Feature 18 — Standard library `std/log` (+ the `extern "c"` machinery)
// Spec: §40 (C interop), Phase D + Phase J
//
// Ships the stdlib delivery mechanism with one real module. `std/log` is plain
// Delta written on top of `extern "c"`, exporting:
//   info(message: cstringview, value: int64): void
//   warn(message: cstringview, value: int64): void
//   error(message: cstringview, value: int64): void
// `std/...` imports resolve against the embedded stdlib FS. When the module graph
// touches any `std/...` module, the build appends the C runtime shim and links it.
//
// Pipeline work:
//   parser/sema: `extern "c" { function f(...); }` declarations (Phase D);
//                `cstringview` type; `std/...` import resolution against embedded FS.
//   codegen    : extern decls emit no definition (linked from the shim);
//                inject `stdlib/runtime.c` into the clang source list when std is used.

import { info, warn, error } from "std/log";

function main(): uint8 {
    info("startup", 0);
    info("count", 42);
    warn("threshold exceeded", 100);
    error("fatal code", int64(0) - 1);
    return 0;
}

/* === Generated C (illustrative) ===
   `std/log` is plain Delta over `extern "c"`, so its codegen looks like any other
   module (mangled `delta__std_log__*`). The extern decls bind to the C shim
   `stdlib/runtime.c`, which the build appends to the clang source list whenever
   the module graph touches any `std/...` module. String literals -> cstringview
   -> `const char*`.

// --- from std/log, build/<mode>/c/std_log.c ---
#include <stdint.h>
extern int fprintf(void* stream, const char* fmt, ...);   // extern "c"
extern const char* delta_rt_stderr_handle(void);          // provided by the shim

void delta__std_log__info(const char* message, int64_t value) {
    fprintf((void*)delta_rt_stderr_handle(), "INFO  %s %lld\n", message, (long long)value);
}
// warn -> "WARN  ...", error -> "ERROR ..."  (same shape)

// --- from main, build/<mode>/c/main.c ---
extern void delta__std_log__info(const char*, int64_t);
extern void delta__std_log__warn(const char*, int64_t);
extern void delta__std_log__error(const char*, int64_t);

int32_t main(void) {
    delta__std_log__info("startup", 0);
    delta__std_log__info("count", 42);
    delta__std_log__warn("threshold exceeded", 100);
    delta__std_log__error("fatal code", delta_sub_i64(0, 1));
    return 0;
}
*/
