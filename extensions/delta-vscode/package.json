{
    "name": "delta-vscode",
    "displayName": "Delta",
    "description": "Language support for the Delta programming language.",
    "version": "0.3.9",
    "publisher": "delta-lang",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:delta"
    ],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "delta",
                "aliases": [
                    "Delta",
                    "delta"
                ],
                "extensions": [
                    ".delta"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "delta",
                "scopeName": "source.delta",
                "path": "./syntaxes/delta.tmLanguage.json"
            }
        ],
        "configuration": {
            "title": "Delta",
            "properties": {
                "delta.languageServer.path": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Optional path to the Delta language-server entry point. Leave empty to use this extension's bundled server."
                },
                "delta.autoImports.enabled": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Offer exported symbols from other Delta modules in completion and add the corresponding named import when selected."
                }
            }
        }
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0"
    }
}
