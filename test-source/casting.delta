// Phase A casting smoke test.
// Exercises `T(x)` numeric conversions across the primitive surface:
//   - free widening within a signedness family
//   - in-range narrowing (trap helper runs but does not fire)
//   - sign-flip with non-negative values (trap helper runs but does not fire)
//   - int <-> float in both directions
//   - float64 <-> float32
//   - uint32 -> char
//   - bridging mismatched parameter types at call sites with explicit T(x)
//
// Expected exit code: 0. Any failing arm returns a distinct non-zero code so
// the failing line is visible from `$?`.

function add_i64(a: int64, b: int64): int64 {
    return a + b;
}

function add_u32(a: uint32, b: uint32): uint32 {
    return a + b;
}

function add_f32(a: float32, b: float32): float32 {
    return a + b;
}

function add_f64(a: float64, b: float64): float64 {
    return a + b;
}

function is_vowel(c: char): int32 {
    switch (c) {
        case 'a', 'e', 'i', 'o', 'u':  return 1; 
        default:                        return 0; 
    }
}

function main(): uint8 {
    // --- free widening: same signedness, wider destination ---
    let s8:  int8  = 100;
    let s16: int16 = int16(s8);
    let s32: int32 = int32(s16);
    let s64: int64 = int64(s32);
    if (s64 != 100) { return 1; }

    let u8v:  uint8  = 200;
    let u16v: uint16 = uint16(u8v);
    let u32v: uint32 = uint32(u16v);
    let u64v: uint64 = uint64(u32v);
    if (u64v != 200) { return 2; }

    // --- in-range narrowing (trap helper validates, passes) ---
    let wide: int64 = 12345;
    let narrow: int16 = int16(wide);
    if (narrow != 12345) { return 3; }

    let uwide: uint64 = 250;
    let unarrow: uint8 = uint8(uwide);
    if (unarrow != 250) { return 4; }

    // --- sign-flip, same width, non-negative source ---
    let pos_s: int32 = 42;
    let pos_u: uint32 = uint32(pos_s);
    if (pos_u != 42) { return 5; }

    let pos_u2: uint16 = 7;
    let pos_s2: int16 = int16(pos_u2);
    if (pos_s2 != 7) { return 6; }

    // --- int -> float ---
    let n: int32 = 9;
    let f: float64 = float64(n);
    if (f != 9.0) { return 7; }

    // --- float -> int (truncates toward zero) ---
    let frac: float64 = 3.75;
    let trunc: int32 = int32(frac);
    if (trunc != 3) { return 8; }

    // --- float64 <-> float32 ---
    let big: float64 = 2.5;
    let small: float32 = float32(big);
    let back: float64 = float64(small);
    if (back != 2.5) { return 9; }

    // --- uint32 -> char ---
    let cp: uint32 = 65;          // 'A'
    let ch: char = char(cp);
    if (ch != 'A') { return 10; }

    // --- intsize widening identity from int32 ---
    let z: intsize = intsize(int32(123));
    let z64: int64 = int64(z);
    if (z64 != 123) { return 11; }

    let uz: uintsize = uintsize(uint32(456));
    let uz64: uint64 = uint64(uz);
    if (uz64 != 456) { return 12; }

    // --- mismatched call args bridged by explicit T(x) ---

    // add_i64 wants int64; both args are narrower / different widths.
    let a32: int32 = 10;
    let b16: int16 = 20;
    if (add_i64(int64(a32), int64(b16)) != 30) { return 13; }

    // add_u32 wants uint32; cross signedness on `a` and widen `b`.
    let mix_a: int32 = 5;
    let mix_b: uint16 = 6;
    if (add_u32(uint32(mix_a), uint32(mix_b)) != 11) { return 14; }

    // add_f32 wants float32; bridge int32 and float64 separately.
    let int_val: int32 = 4;
    let flt_val: float64 = 0.5;
    let r32: float32 = add_f32(float32(int_val), float32(flt_val));
    if (r32 != 4.5) { return 15; }

    // add_f64 wants float64; bridge a float32 and an integer.
    let small_f: float32 = 1.25;
    let int_again: int64 = 3;
    let r64: float64 = add_f64(float64(small_f), float64(int_again));
    if (r64 != 4.25) { return 16; }

    // char-typed parameter: build the codepoint from a uint32 and convert.
    let code: uint32 = 101;        // 'e'
    if (is_vowel(char(code)) != 1) { return 17; }

    let code2: uint32 = 122;       // 'z'
    if (is_vowel(char(code2)) != 0) { return 18; }

    return 0;
}
