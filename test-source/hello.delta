// Phase B smoke test.
// Exercises: C-style for (basic, empty-init, empty-step), postfix ++/--,
// break, continue (across the for-step), switch (single / multi-label / char /
// negative literals / default), switch-as-return-coverage-sink, break targeting
// an enclosing loop through a switch, `let name: T;` with definite assignment
// across an if/else merge, and const bindings inside loops.
//
// Expected exit code: 0.

// Uninitialized `let`, then definite assignment on both branches of if/else
// before any read. Exercises the dataflow lattice merge.
function gcd(a: int64, b: int64): int64 {
    let x: int64;
    let y: int64;
    if (a < b) { x = b; y = a; } else { x = a; y = b; }
    while (y != 0) {
        const t = y;
        y = x % y;
        x = t;
    }
    return x;
}

// Switch with single, multi-label, negative-literal, and default cases.
// All paths return — switch acts as a return-coverage sink.
function classify(n: int32): int32 {
    switch (n) {
        case 0:           { return 100; }
        case 1, 2, 3:     { return 200; }
        case -1, -2, -3:  { return 300; }
        default:          { return 999; }
    }
}

// Switch over `char` scrutinee. Multi-label and default.
function vowel_score(c: char): int32 {
    switch (c) {
        case 'a', 'e', 'i', 'o', 'u':  { return 1; }
        default:                        { return 0; }
    }
}

// Switch with a default whose body branches and returns from both arms —
// exercises return-coverage joining out of a nested if inside default.
function sign(n: int32): int32 {
    switch (n) {
        case 0:   { return 0; }
        default:  {
            if (n > 0) { return 1; }
            else       { return -1; }
        }
    }
}

// Postfix ++ / -- as expressions, with the pre-update value captured.
function postfix_demo(): int32 {
    let i: int32 = 10;
    let a: int32 = i++;   // a == 10, i == 11
    let b: int32 = i--;   // b == 11, i == 10
    return a + b + i;     // 10 + 11 + 10 == 31
}

// Three for-loop shapes: full, empty-step (body advances), empty-init (outer var).
function loop_variants(): int32 {
    let total: int32 = 0;

    // Full form. Sum of 1..=10 is 55.
    for (let i: int32 = 1; i <= 10; i++) {
        total = total + i;
    }

    // Empty step — body owns the advance.
    for (let i: int32 = 0; i < 5; ) {
        total = total + i;
        i++;
    }

    // Empty init — induction variable declared outside the for.
    let j: int32 = 0;
    for (; j < 3; j++) {
        total = total + j;
    }

    // 55 + (0+1+2+3+4) + (0+1+2) == 55 + 10 + 3 == 68.
    return total;
}

// `continue` must still run the for-step (the codegen `goto __delta_for_step_N`
// trick); `break` exits the loop. Sums even numbers in 0..10.
function break_continue_demo(): int32 {
    let sum: int32 = 0;
    for (let i: int32 = 0; i < 20; i++) {
        if (i == 10)    { break; }
        if (i % 2 != 0) { continue; }
        sum = sum + i;
    }
    // 0+2+4+6+8 == 20.
    return sum;
}

// Decision 8: `break` inside a switch targets the nearest enclosing loop,
// not the switch. If this were lowered as a literal C `break;`, the for-loop
// would keep running and `found` would never stabilize at 7.
function switch_break_in_loop(): int32 {
    let found: int32 = -1;
    for (let i: int32 = 0; i < 100; i++) {
        switch (i) {
            case 7: {
                found = i;
                break;       // exits the for-loop, per Decision 8
            }
            default: { }     // case ends, for-step runs, loop continues
        }
    }
    return found;   // 7
}

// `continue` through a switch likewise targets the loop. Counts non-zero
// digits in 0..10 by skipping zero from inside a switch case.
function switch_continue_in_loop(): int32 {
    let count: int32 = 0;
    for (let i: int32 = 0; i < 10; i++) {
        switch (i) {
            case 0:  { continue; }   // targets the for, runs the for-step
            default: { count++; }
        }
    }
    return count;   // 9
}

function main(): uint8 {
    // gcd: gcd(48, 18) == 6.
    if (gcd(48, 18) != 6)               { return 1; }
    if (gcd(18, 48) != 6)               { return 2; }   // (a < b) branch

    // classify spot checks across all four arms.
    if (classify(0)   != 100)           { return 3; }
    if (classify(2)   != 200)           { return 4; }
    if (classify(-3)  != 300)           { return 5; }
    if (classify(42)  != 999)           { return 6; }

    // vowel_score — char scrutinee.
    if (vowel_score('a') != 1)          { return 7; }
    if (vowel_score('u') != 1)          { return 8; }
    if (vowel_score('z') != 0)          { return 9; }

    // sign — switch default arm with internal branch-and-return.
    if (sign(0)  != 0)                  { return 10; }
    if (sign(5)  != 1)                  { return 11; }
    if (sign(-5) != -1)                 { return 12; }

    // Postfix value semantics.
    if (postfix_demo() != 31)           { return 13; }

    // for variants.
    if (loop_variants() != 68)          { return 14; }

    // break + continue with the for-step pitfall.
    if (break_continue_demo() != 20)    { return 15; }

    // break through switch targets the loop.
    if (switch_break_in_loop() != 7)    { return 16; }

    // continue through switch targets the loop.
    if (switch_continue_in_loop() != 9) { return 17; }

    return 0;
}