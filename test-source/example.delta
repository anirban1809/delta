function gcd(a: int32, b: int32): int64 {
    let x: int64;
    let y: int64;
    if (a < b) { x = b; y = a; } else { x = a; y = b; }
    while (y != 0) {
        const t = y;
        y = x % y;
        x = t;
    }
    return x;
}

function main():int32 {
    if (gcd(48, 48) == 0) {
        return 1;
    }
    return 0;
}