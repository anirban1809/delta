function gcd(a: int64, b: int64): int64 {
    let x: int64;
    let y: int64;
    if (a < b) { x = b; y = a; } else { x = a; y = b; }
    while (y != 0) {
        const t = y;
        y = x % y;
        x = t;
    }
    return x;
}

