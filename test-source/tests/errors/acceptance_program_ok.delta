type OverflowError = { };

function safeAdd(a: int64, b: int64): int64 | OverflowError {
    const sum = a + b as result;
    check result {
        return error as { };
    }
    return sum;
}

function main(): int32 {
    const x = safeAdd(1_000_000_000_000, 999) as result;
    check result {
        return 1;
    }
    if (x == 1_000_000_000_999) {
        return 0;
    }
    return 2;
}
