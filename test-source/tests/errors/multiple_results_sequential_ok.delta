type struct OverflowError = { };

function step(x: int32): int32 | OverflowError {
    const y = x + 1 as result;
    check result {
        return error as { };
    }
    return y;
}

function main(): uint8 {
    const a = step(1) as result;
    check result {
        return uint8(1);
    }
    const b = step(a) as result;
    check result {
        return uint8(2);
    }
    if (b == 3) {
        return uint8(0);
    }
    return uint8(3);
}
