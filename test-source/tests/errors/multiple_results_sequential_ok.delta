type struct OverflowError = { };

function step(x: int32): int32 | OverflowError {
    const y = x + 1 as result;
    check result {
        return error as { };
    }
    return y;
}

function main(): int8 {
    const a = step(1) as result;
    check result {
        return int8(1);
    }
    const b = step(a) as result;
    check result {
        return int8(2);
    }
    if (b == 3) {
        return int8(0);
    }
    return int8(3);
}
