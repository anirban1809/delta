type OverflowError = { };

function step(x: int32): int32 | OverflowError {
    const y = x + 1 as result;
    check result {
        return error as { };
    }
    return y;
}

function main(): int32 {
    const a = step(1) as result;
    check result {
        return 1;
    }
    const b = step(a) as result;
    check result {
        return 2;
    }
    if (b == 3) {
        return 0;
    }
    return 3;
}
