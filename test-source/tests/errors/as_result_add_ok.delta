type struct OverflowError = { };

function safeAdd(a: int64, b: int64): int64 | OverflowError {
    const sum = a + b as result;
    check result {
        return error as { };
    }
    return sum;
}

function main(): int8 {
    const x = safeAdd(2, 3) as result;
    check result {
        return int8(1);
    }
    if (x == 5) {
        return int8(0);
    }
    return int8(2);
}
