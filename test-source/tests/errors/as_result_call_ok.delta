type OverflowError = { };

function safeAdd(a: int64, b: int64): int64 | OverflowError {
    const sum = a + b as result;
    check result {
        return error as { };
    }
    return sum;
}

function addThree(a: int64, b: int64, c: int64): int64 | OverflowError {
    const ab = safeAdd(a, b) as result;
    check result {
        return error as { };
    }
    const abc = safeAdd(ab, c) as result;
    check result {
        return error as { };
    }
    return abc;
}

function main(): int32 {
    const total = addThree(1, 2, 3) as result;
    check result {
        return 1;
    }
    if (total == 6) {
        return 0;
    }
    return 2;
}
