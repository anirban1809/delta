type struct OverflowError = { overflow: bool };
type struct DivideByZeroError = { divideByZero: bool };

function calculate(): int32 | OverflowError, DivideByZeroError {
    return 1;
}

function main(): int8 {
    const value = calculate() as result;
    check result as OverflowError {
        return 1;
    }
    return 0;
}
