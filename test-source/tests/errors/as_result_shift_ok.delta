type struct ShiftCountError = { };

function safeShift(a: int32, n: int32): int32 | ShiftCountError {
    const s = a << n as result;
    check result {
        return error as { };
    }
    return s;
}

function main(): int8 {
    const s = safeShift(1, 4) as result;
    check result {
        return int8(1);
    }
    if (s == 16) {
        return int8(0);
    }
    return int8(2);
}
