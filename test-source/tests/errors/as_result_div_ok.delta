type struct DivideByZeroError = { };

function safeDiv(a: int32, b: int32): int32 | DivideByZeroError {
    const q = a / b as result;
    check result {
        return error as { };
    }
    return q;
}

function main(): int8 {
    const r = safeDiv(10, 2) as result;
    check result {
        return int8(1);
    }
    if (r == 5) {
        return int8(0);
    }
    return int8(2);
}
