type struct OverflowError = { x: int32 };

function accumulate(a: int64, b: int64): int64 | OverflowError {
    let acc: int64 = a;
    let x: OverflowError = {x:34};
    
    acc = acc + b as result;
    check result {
        return error as x;
    }
    return acc;
}

function main(): uint8 {
    const total = accumulate(10, 20) as result;
    check result {
        return uint8(1);
    }
    if (total == 30) {
        return uint8(0);
    }
    return uint8(2);
}
