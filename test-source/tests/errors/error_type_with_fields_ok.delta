type struct ParseError = { code: int32, line: int32 };

function parse(x: int32): int32 | ParseError {
    if (x < 0) {
        return error as { code: 1, line: 0 };
    }
    return x;
}

function main(): uint8 {
    const r = parse(5) as result;
    check result {
        return uint8(1);
    }
    if (r == 5) {
        return uint8(0);
    }
    return uint8(2);
}
