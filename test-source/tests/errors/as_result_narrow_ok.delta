type struct NarrowingError = { };

function safeNarrow(big: int64): int32 | NarrowingError {
    const small = int32(big) as result;
    check result {
        return error as { };
    }
    return small;
}

function main(): int8 {
    const v = safeNarrow(42) as result;
    check result {
        return int8(1);
    }
    if (v == 42) {
        return int8(0);
    }
    return int8(2);
}
