type struct Vec3 = { x: float64, y: float64, z: float64 };

function main(): uint8 {
    let v: Vec3 = Vec3 { x: 1.0, y: 2.0, z: 3.0 };
    if (v.x != 1.0) { return uint8(1); }
    if (v.y != 2.0) { return uint8(2); }
    if (v.z != 3.0) { return uint8(3); }
    v = Vec3 { x: 3.5, y: 2.6, z: 4.0 };
    if (v.x != 3.5) { return uint8(4); }
    return uint8(0);
}
