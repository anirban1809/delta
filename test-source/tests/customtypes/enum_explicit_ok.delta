type enum Facing = { North: 0, East: 90, South: 180, West: 270 };

function main(): int8 {
    const heading: Facing = Facing.East;
    if (heading != Facing.East)  { return int8(1); }
    if (heading == Facing.North) { return int8(2); }
    if (heading != 90)           { return int8(3); }
    return int8(0);
}
