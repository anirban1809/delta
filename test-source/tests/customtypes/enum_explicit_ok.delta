type enum Facing = { North: 0, East: 90, South: 180, West: 270 };

function main(): uint8 {
    const heading: Facing = Facing.East;
    if (heading != Facing.East)  { return uint8(1); }
    if (heading == Facing.North) { return uint8(2); }
    if (heading != 90)           { return uint8(3); }
    return uint8(0);
}
