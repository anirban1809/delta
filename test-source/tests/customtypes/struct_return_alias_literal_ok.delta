type struct Vec3 = { x: int32, y: int32, z: int32 };
type Position    = Vec3;

function makePosition(): Position {
    return Vec3 { x: 8, y: 13, z: 21 };
}

function main(): int8 {
    const value: Vec3 = makePosition();
    if (value.x != 8)  { return int8(1); }
    if (value.y != 13) { return int8(2); }
    if (value.z != 21) { return int8(3); }
    return int8(0);
}
