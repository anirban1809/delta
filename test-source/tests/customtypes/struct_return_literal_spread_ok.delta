type struct Vec3 = { x: int32, y: int32, z: int32 };

function copyVec3(source: Vec3): Vec3 {
    return Vec3 { ...source };
}

function main(): uint8 {
    const source: Vec3 = Vec3 { x: 2, y: 3, z: 5 };
    const copy: Vec3 = copyVec3(source);
    if (copy.x != 2) { return uint8(1); }
    if (copy.y != 3) { return uint8(2); }
    if (copy.z != 5) { return uint8(3); }
    return uint8(0);
}
