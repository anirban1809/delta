type struct Vec3  = { x: float64, y: float64, z: float64 };
type struct Vec3B = { x: float64, y: float64, z: float64 };

function main(): uint8 {
    const a: Vec3B = Vec3B { x: 1.0, y: 2.0, z: 3.0 };
    // Vec3B is a distinct nominal type, but its fields match Vec3 by name and type,
    // so a full spread into a Vec3 literal is allowed (spread is structural)
    const b: Vec3 = Vec3 { ...a };
    if (int32(b.x) != 1) { return uint8(1); }
    if (int32(b.y) != 2) { return uint8(2); }
    if (int32(b.z) != 3) { return uint8(3); }
    return uint8(0);
}
