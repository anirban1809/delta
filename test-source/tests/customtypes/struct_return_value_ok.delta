type struct Vec3 = { x: float64, y: float64, z: float64 };

function returnVec3(value: Vec3): Vec3 {
    return value;
}

function main(): int8 {
    const source: Vec3 = Vec3 { x: 2.0, y: 3.0, z: 4.0 };
    const value: Vec3 = returnVec3(source);
    if (value.x != 2.0) { return int8(1); }
    if (value.y != 3.0) { return int8(2); }
    if (value.z != 4.0) { return int8(3); }
    return int8(0);
}
