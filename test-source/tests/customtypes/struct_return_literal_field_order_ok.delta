type struct Vec3 = { x: int32, y: int32, z: int32 };

function makeVec3(): Vec3 {
    return Vec3 { z: 55, x: 23, y: 65 };
}

function main(): int32 {
    const value: Vec3 = makeVec3();
    if (value.x != 23) { return 1; }
    if (value.y != 65) { return 2; }
    if (value.z != 55) { return 3; }
    return 0;
}
