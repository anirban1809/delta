type struct Vec3 = { x: float64, y: float64, z: float64 };

function main(): uint8 {
    const a: Vec3 = Vec3 { x: 1.0, y: 2.0, z: 3.0 };
    const b: Vec3 = Vec3 { x: 1.0, y: 2.0, z: 3.0 };
    // struct `==` would synthesize a hidden fieldwise comparison — not supported
    if (a == b) { return 1; }
    return 0;
}
