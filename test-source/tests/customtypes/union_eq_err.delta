type struct Circle = { r: float64 };
type struct Square = { s: float64 };

type union Shape = Circle | Square;

function main(): int32 {
    const a: Shape = Circle { r: 2.0 };
    const b: Shape = Circle { r: 2.0 };
    // union `==` would synthesize a hidden tag-dispatching comparison — not supported
    if (a == b) { return 1; }
    return 0;
}
