type struct Vec3      = { x: int32, y: int32, z: int32 };
type struct Transform = { position: Vec3, visible: bool };

function makeTransform(): Transform {
    return Transform {
        position: Vec3 { x: 3, y: 5, z: 8 },
        visible: true
    };
}

function main(): uint8 {
    const transform: Transform = makeTransform();
    if (transform.position.x != 3) { return uint8(1); }
    if (!transform.visible)        { return uint8(2); }
    return uint8(0);
}
