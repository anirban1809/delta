type struct Vec3 = { x: float64, y: float64, z: float64 };

function main(): int8 {
    // the literal names its type, so the binding type is inferred from it
    const v = Vec3 { x: 1.0, y: 2.0, z: 3.0 };
    if (v.x != 1.0) { return int8(1); }
    if (v.z != 3.0) { return int8(2); }
    return int8(0);
}
