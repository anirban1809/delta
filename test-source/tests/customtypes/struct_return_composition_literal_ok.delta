type struct Animal = { species: int32, age: int32 };
type struct Dog    = { ...Animal, goodBoy: bool };

function makeDog(): Dog {
    return Dog { goodBoy: true, age: 4, species: 1 };
}

function main(): int32 {
    const dog: Dog = makeDog();
    if (dog.species != 1) { return 1; }
    if (dog.age != 4)     { return 2; }
    if (!dog.goodBoy)     { return 3; }
    return 0;
}
