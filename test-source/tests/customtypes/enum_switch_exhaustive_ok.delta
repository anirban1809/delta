type enum Facing = { North: 0, East: 90, South: 180, West: 270 };

function rank(f: Facing): int32 {
    switch (f) {
        case Facing.North:  
            return 1; 
        case Facing.East: 
            return 2;
        case Facing.South: 
            return 3;
        case Facing.West:  
            return 4;
    }
}

function main(): int8 {
    if (rank(Facing.South) != 3) { return int8(1); }
    return int8(0);
}
