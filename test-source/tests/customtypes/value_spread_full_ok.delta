type struct Vec3 = { x: float64, y: float64, z: float64 };

function main(): uint8 {
    const a: Vec3 = Vec3 { x: 1.0, y: 2.0, z: 2.0 };
    const b: Vec3 = Vec3 { ...a};
    if (int32(b.x) != 1) { return uint8(1); }
    if (int32(b.y) != 2) { return uint8(2); }
    if (int32(b.z) != 2) { return uint8(3); }
    return uint8(0);
}
