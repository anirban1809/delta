type struct Animal = { species: int32, age: int32 };
type AnimalAlias   = Animal;
type struct Dog    = { ...AnimalAlias, goodBoy: bool };

function main(): int8 {
    const d: Dog = Dog { species: 1, age: 3, goodBoy: true };
    if (d.species != 1) { return int8(1); }
    if (d.age != 3)     { return int8(2); }
    if (!d.goodBoy)     { return int8(3); }
    return int8(0);
}
