type enum Facing = { North: 0, East: 90, South: 180, West: 270 };

function main(): uint8 {
    // an enum member IS an int32 literal — no cast needed
    if (Facing.East != 90)  { return uint8(1); }
    if (Facing.West != 270) { return uint8(2); }

    // interchanges with any integer type
    const sum: int64 = Facing.East + Facing.South;
    if (sum != 270) { return uint8(3); }

    const wide: int16 = Facing.North;
    if (wide != 0) { return uint8(4); }
    return uint8(0);
}
