type struct Leaf = { value: int32 };
type struct Branch = { leaf: owned<Leaf> };
type struct Root = { branch: owned<Branch> };

function main(): uint8 {
    const leaf = new Leaf { value: 5 };
    const branch = new Branch { leaf: leaf };
    const root: Root = Root {
        branch: branch
    };
    const result = root.branch.leaf.value;
    return uint8(result);
}
