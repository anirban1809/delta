type struct Payload = { count: int32 };
type struct Holder = { payload: owned<Payload> };

function read(payload: Payload): int32 {
    return payload.count;
}

function main(): uint8 {
    const payload = new Payload { count: 3 };
    const holder: Holder = Holder { payload: payload };
    const result = read(holder.payload);
    return uint8(result);
}
