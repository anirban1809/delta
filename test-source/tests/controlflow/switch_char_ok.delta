function vowel(c: char): int32 {
    switch (c) {
        case 'a', 'e', 'i', 'o', 'u': return 0;
        default:                       return 1;
    }
}

function main(): uint8 {
    if (vowel('a') != 0) { return uint8(1); }
    if (vowel('e') != 0) { return uint8(2); }
    if (vowel('u') != 0) { return uint8(3); }
    if (vowel('z') != 1) { return uint8(4); }
    return uint8(0);
}
