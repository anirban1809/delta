function main(): int8 {
    let n: int32 = 1;
    switch (n) {
        case 1: 
            let x: int32 = 10;
            if (x != 10) { return int8(1); }
        
        case 2: 
            let x: int32 = 20;
            if (x != 20) { return int8(2); }
        
        default:
            return int8(-1);
    }
    return int8(0);
}
