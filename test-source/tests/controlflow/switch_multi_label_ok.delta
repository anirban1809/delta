function checkValue(n: int32): int32 {
    switch (n) {
        case 1, 2, 3: return 0;
        default:      return 1;
    }
}

function main(): uint8 {
    if (checkValue(1) != 0) { return uint8(1); }
    if (checkValue(2) != 0) { return uint8(2); }
    if (checkValue(3) != 0) { return uint8(3); }
    if (checkValue(4) != 1) { return uint8(4); }
    return uint8(0);
}
