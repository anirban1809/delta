function check(n: int32): int32 {
    switch (n) {
        case 1, 2, 3: { return 0; }
        default:      { return 1; }
    }
}

function main(): int32 {
    if (check(1) != 0) { return 1; }
    if (check(2) != 0) { return 2; }
    if (check(3) != 0) { return 3; }
    if (check(4) != 1) { return 4; }
    return 0;
}
