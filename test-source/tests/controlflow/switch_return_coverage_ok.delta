function pick(n: int32): int32 {
    switch (n) {
        case 0:   return 100;
        case 1:   return 200;
        default:  return 300;
    }
}

function main(): uint8 {
    if (pick(0) != 100) { return uint8(1); }
    if (pick(1) != 200) { return uint8(2); }
    if (pick(9) != 300) { return uint8(3); }
    return uint8(0);
}
