function classify(n: int32): int32 {
    switch (n) {
        case -2, -1:  return 0;
        case 0:       return 1;
        case 1, 2:    return 2;
        default:      return 3;
    }
}

function main(): uint8 {
    if (classify(-2) != 0) { return uint8(1); }
    if (classify(-1) != 0) { return uint8(2); }
    if (classify(0)  != 1) { return uint8(3); }
    if (classify(2)  != 2) { return uint8(4); }
    if (classify(5)  != 3) { return uint8(5); }
    return uint8(0);
}
