function main(): int8 {
    let found: int32 = -1;
    for (let i: int32 = 0; i < 100; i++) {
        switch (i) {
            case 7:
                found = i;
                break;
            default:
                found = 10;
        }
    }
    if (found != 7) { return int8(1); }
    return int8(0);
}
