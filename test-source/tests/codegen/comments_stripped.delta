// File-scope const for the doubling example.
const limit: int32 = 100;

// Doubles its input and returns the result.
function dbl(x: int32): int32 {
    // multiply by two
    return x * 2;
}

// Entry point — calls the helper with the file const.
function main(): int32 {
    // delegate to dbl
    return dbl(limit);
}
