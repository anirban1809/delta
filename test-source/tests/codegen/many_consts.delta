const max_iter: int32 = 100;
const threshold: int32 = 42;
const enabled: bool = true;

function should_run(): bool {
    return enabled;
}

function clamp(x: int32): int32 {
    if (x > max_iter) {
        return max_iter;
    } else {
        if (x < 0) {
            return 0;
        } else {
            return x;
        }
    }
}

function main(): int32 {
    if (should_run()) {
        return clamp(threshold);
    } else {
        return 0;
    }
}
