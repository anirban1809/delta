function classify(x: int32): int32 {
    let count: int32 = 0;
    let i: int32 = 0;
    while (i < x) {
        if (i < 5) {
            count = count + 1;
        } else {
            if (i < 10) {
                count = count + 2;
            } else {
                count = count + 3;
            }
        }
        i = i + 1;
    }
    return count;
}

function main(): int32 {
    return classify(15);
}
