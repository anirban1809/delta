// An error set is a closed set of alternatives. Each error path returns one
// declared variant.
type ErrA = { a: bool; };
type ErrB = { b: bool; };

function f(flag: bool): int32 | ErrA, ErrB {
    if (flag) {
        return error as { a: true };
    }
    return 0;
}

function main(): uint8 {
    return uint8(0);
}
