interface Readable {
    function value(): int32;
}

interface Incrementable {
    function increment(): void;
}

type struct counter = {
    stored: int32
} implements Readable, Incrementable;

function (counter: &counter) value(): int32 {
    return counter.stored;
}

function (counter: edit &counter) increment(): void {
    counter.stored = counter.stored + 1;
}

function increment_and_read<C: Readable & Incrementable>(
    item: edit &C
): int32 {
    item.increment();
    return item.value();
}

function main(): uint8 {
    let instance = counter { stored: 17 };
    return uint8(increment_and_read(instance));
}
