interface Readable {
    function value(): int32;
}

type struct read_box = {
    stored: int32
} implements Readable;

type struct edit_box = {
    stored: int32
} implements Readable;

function (box: &read_box) value(): int32 {
    return box.stored;
}

function (box: edit &edit_box) value(): int32 {
    return box.stored;
}

function read_value<R: Readable>(reader: edit &R): int32 {
    return reader.value();
}

function main(): uint8 {
    let first = read_box { stored: 4 };
    let second = edit_box { stored: 5 };
    return uint8(read_value(first) + read_value(second));
}

