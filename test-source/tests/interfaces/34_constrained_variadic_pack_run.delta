interface Printable {
    function marker(): uint8;
}

type struct first = {
    value: uint8
} implements Printable;

type struct second = {
    value: uint8
} implements Printable;

function (value: &first) marker(): uint8 {
    return value.value;
}

function (value: &second) marker(): uint8 {
    return value.value;
}

function printable_count<...T: Printable>(...values: T): uint8 {
    return uint8(values.length);
}

function main(): uint8 {
    const a = first { value: uint8(1) };
    const b = second { value: uint8(2) };
    return printable_count(a, b);
}
