interface printable {
    function print();
}

type struct printer = {
    prints: int32
} implements printable;

function (s: edit &printer) print() {
    s.prints = s.prints + 1;
}

function use_printables<P: printable>(p: edit &P) {
    p.print();
    p.print();
}

function main(): uint8 {
    let x = printer { prints: 0 };
    use_printables(x);
    return uint8(x.prints);
}
