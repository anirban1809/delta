interface Printable {
    function marker(): uint8;
}

type struct printable = {
    value: uint8
} implements Printable;

type struct hidden = {
    value: uint8
};

function (value: &printable) marker(): uint8 {
    return value.value;
}

function printable_count<...T: Printable>(...values: T): uint8 {
    return uint8(values.length);
}

function main(): uint8 {
    const a = printable { value: uint8(1) };
    const b = hidden { value: uint8(2) };
    return printable_count(a, b);
}
