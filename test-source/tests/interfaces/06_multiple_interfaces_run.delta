interface Readable {
    function current(): int32;
}

interface Incrementable {
    function increment(): void;
}

type struct counter = {
    value: int32
} implements Readable, Incrementable;

function (counter: &counter) current(): int32 {
    return counter.value;
}

function (counter: edit &counter) increment(): void {
    counter.value = counter.value + 1;
}

function main(): uint8 {
    let value = counter { value: 5 };
    value.increment();
    return uint8(value.current());
}

