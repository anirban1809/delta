interface Readable {
    function value(): int32;
}

type struct number_box = {
    stored: int32
} implements Readable;

function (box: &number_box) value(): int32 {
    return box.stored;
}

function read_value<R: Readable>(reader: edit &R): int32 {
    return reader.value();
}

function main(): uint8 {
    let box = number_box { stored: 16 };
    return uint8(read_value(box));
}

