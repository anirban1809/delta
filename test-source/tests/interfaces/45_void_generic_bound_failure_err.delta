interface Bumpable {
    function bump(): int32;
}

type struct counter = {
    hits: int32
} implements Bumpable;

type struct memory_block = {
    size: int32
};

function (c: edit &counter) bump(): int32 {
    c.hits = c.hits + 1;
    return c.hits;
}

function bump_once<B: Bumpable>(target: edit &B): void {
    target.bump();
    return;
}

function main(): uint8 {
    let block = memory_block { size: 3 };
    bump_once(block);
    return uint8(0);
}
