// Doc case: Implicit return transfer of a non-Copyable value.
// Target C: materialize the return value, drop OTHER live locals, return without dropping it.
unique type Handle = { id: int32; };

function (handle: edit &Handle) dispose() {
    handle.id = 0;
}

function identity(value: Handle): Handle {
    return value;
}

function main(): uint8 {
    let value: Handle = { id: 7 };
    let result = identity(move value);
    return uint8(result.id);
}
