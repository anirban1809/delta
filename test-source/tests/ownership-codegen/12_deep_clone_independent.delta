type Box = { value: owned<int32>; };

function read(value: int32): int32 { return value; }

function main(): int8 {
    let original: Box = { value: new 7 };
    let duplicate = clone original as result;
    check result { return int8(99); }
    duplicate.value = new 9;
    return int8(read(original.value));
}
