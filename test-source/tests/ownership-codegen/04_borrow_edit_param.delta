// Doc case: `edit &T` parameter -> `T*`, mutation through the pointer.
// Target C: void delta__increment(delta__Counter* counter) { counter->value = (counter->value + 1); }
type Counter = { value: int32; };

function increment(counter: edit &Counter) {
    counter.value = counter.value + 1;
}

function main(): uint8 {
    let counter: Counter = { value: 7 };
    increment(counter);
    return uint8(counter.value);
}
