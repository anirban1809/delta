// Doc case: Owned-replacement assignment -> materialize, drop old, store.
// Target C:
//   delta__Handle __delta_replacement_0 = next;
//   delta__Handle_drop(&current);
//   current = __delta_replacement_0;   // next is Moved, not dropped
unique type Handle = { id: int32; };

function (handle: edit &Handle) dispose() {
    handle.id = 0;
}

function main(): int32 {
    let current: Handle = { id: 1 };
    let next: Handle = { id: 2 };
    current = move next;
    return current.id;
}
