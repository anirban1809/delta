type Vec3 = { x: int32; y: int32; z: int32; };
type Position = Vec3;

function makePosition(): Position {
    return { x: 8, y: 13, z: 21 };
}

function main(): int32 {
    const value: Vec3 = makePosition();
    if (value.x != 8)  { return 1; }
    if (value.y != 13) { return 2; }
    if (value.z != 21) { return 3; }
    return 0;
}
