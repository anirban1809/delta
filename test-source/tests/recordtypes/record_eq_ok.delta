type Vec3 = { x: float64; y: float64; z: float64; };

function main(): int32 {
    const a: Vec3 = { x: 1.0, y: 2.0, z: 3.0 };
    const b: Vec3 = { x: 1.0, y: 2.0, z: 3.0 };
    const c: Vec3 = { x: 1.0, y: 2.0, z: 4.0 };
    if (!(a == b)) { return 1; }
    if (a == c)    { return 2; }
    if (!(a != c)) { return 3; }
    if (a != b)    { return 4; }
    return 0;
}
