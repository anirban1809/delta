type Rect = { w: int32; h: int32; };

function (r: &Rect) width(): int32 {
    return r.w;
}

function (r: &Rect) height(): int32 {
    return r.h;
}

function (r: &Rect) area(): int32 {
    return r.w * r.h;
}

function main(): int8 {
    let r: Rect = { w: 3, h: 4 };
    return int8(r.area() + r.width() + r.height());
}
