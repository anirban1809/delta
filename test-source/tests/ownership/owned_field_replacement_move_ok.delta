// An owned field may be replaced from a distinct moved binding (session.handle = move next). Expects pass.
unique type Handle = { id: int32; };
type Session = { handle: Handle; generation: int32; };

function main(): int32 {
    let session: Session = { handle: { id: 1 }, generation: 1 };
    let next: Handle = { id: 2 };
    session.handle = move next;
    return session.handle.id;
}
