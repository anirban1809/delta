// Assigning a bare Unique value into an owned field is rejected (session.handle = next). Expects fail ("non-copyable").
unique type Handle = { id: int32; };
type Session = { handle: Handle; generation: int32; };

function main(): int8 {
    let session: Session = { handle: { id: 1 }, generation: 1 };
    let next: Handle = { id: 2 };
    session.handle = next;
    return 0;
}
