// An `edit &T` parameter may be reborrowed down to `&T` for a nested call. Expects pass.
type Counter = { value: int32; };

function inspect(counter: &Counter): int32 { return counter.value; }

function relay(counter: edit &Counter): int32 {
    return inspect(counter);
}

function main(): uint8 {
    let counter: Counter = { value: 7 };
    return uint8(relay(counter));
}
