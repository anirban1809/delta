// A fresh owner declared and moved inside each iteration needs no revival. Expects pass.
unique type Handle = { id: int32; };

function consume(value: Handle) { }

function test(flag: bool) {
    let running = flag;
    while (running) {
        let value: Handle = { id: 7 };
        consume(move value);
        running = false;
    }
}

function main(): uint8 {
    test(false);
    return uint8(0);
}
