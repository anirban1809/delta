// A record containing a Unique member cannot derive clone. Expects fail ("unique").
unique type Handle = { id: int32; };
type Session = { handle: Handle; generation: int32; };

function main(): int32 {
    const value: Session = { handle: { id: 7 }, generation: 1 };
    const duplicate = clone value as result;
    check result { return 1; }
    return 0;
}
