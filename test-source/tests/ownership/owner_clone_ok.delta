// A non-Unique owner duplicates explicitly via fallible `clone ... as result`. Expects pass.
type Box = { value: heap<int32>; };

function inspect(value: &Box) { }

function main(): int8 {
    const original: Box = { value: new 7 };
    const duplicate = clone original as result;
    check result { return int8(1); }
    inspect(original);
    inspect(duplicate);
    return int8(0);
}
