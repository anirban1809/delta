// Multiple immutable auto-borrows of one root may overlap (add(counter, counter)). Expects pass.
type Counter = { value: int32; };

function add(left: &Counter, right: &Counter): int32 {
    return left.value + right.value;
}

function main(): int32 {
    const counter: Counter = { value: 7 };
    return add(counter, counter);
}
