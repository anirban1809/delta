// Uniqueness propagates through a containing record (Session.handle: Handle), blocking copy. Expects fail ("unique").
unique type Handle = { id: int32; };
type Session = { handle: Handle; generation: int32; };

function main(): int32 {
    const a: Session = { handle: { id: 7 }, generation: 1 };
    const b = a;
    return 0;
}
