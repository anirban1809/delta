type struct Ok<T> = { value: T };
type struct Error<E> = { error: E };

type union Result<T, E> = Ok<T> | Error<E>;

function main(): uint8 {
    const inner: Result<int32, char> = Ok<int32> { value: 1 };
    const outer: Result<Result<int32, char>, bool> = Ok<Result<int32, char>> { value: inner };
    return uint8(0);
}
