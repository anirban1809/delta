type struct Ok<T> = { value: T };
type struct Error<E> = { error: E };

type union Result<T, E> = Ok<T> | Error<E>;

function success<T, E>(value: T): Result<T, E> {
    return Ok<T> { value: value };
}

function main(): uint8 {
    const result: Result<int32, char> = success<int32, char>(42);
    return uint8(0);
}
