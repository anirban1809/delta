type struct Ok<T> = { value: T };
type struct Error<E> = { error: E };

type union Result<T, E> = Ok<T> | Error<E>;

function passThrough<T, E>(result: Result<T, E>): Result<T, E> {
    return result;
}

function main(): uint8 {
    const number: Result<int32, char> = Ok<int32> { value: 7 };
    const flag: Result<bool, int32> = Error<int32> { error: 9 };

    const numberAgain: Result<int32, char> = passThrough<int32, char>(number);
    const flagAgain: Result<bool, int32> = passThrough<bool, int32>(flag);
    return uint8(0);
}
