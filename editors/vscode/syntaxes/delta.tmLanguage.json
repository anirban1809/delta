{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Delta",
  "scopeName": "source.delta",
  "fileTypes": ["delta"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#booleans" },
    { "include": "#function-declaration" },
    { "include": "#type-annotation" },
    { "include": "#function-call" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.delta",
          "match": "//.*$"
        },
        {
          "name": "comment.block.delta",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.delta",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.delta",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|[0nrt\\\\\"'])"
            }
          ]
        },
        {
          "name": "string.quoted.single.delta",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.delta",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|[0nrt\\\\\"'])"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.delta",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.delta",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.delta",
          "match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.delta",
          "match": "\\b(if|else|while|return)\\b"
        },
        {
          "name": "storage.type.delta",
          "match": "\\b(function|const|let)\\b"
        }
      ]
    },
    "booleans": {
      "name": "constant.language.boolean.delta",
      "match": "\\b(true|false)\\b"
    },
    "function-declaration": {
      "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.delta" },
        "2": { "name": "entity.name.function.delta" }
      }
    },
    "type-annotation": {
      "match": ":\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.type.delta" }
      }
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.delta" }
      }
    },
    "identifiers": {
      "name": "variable.other.delta",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
