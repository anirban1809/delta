{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Delta",
  "scopeName": "source.delta",
  "fileTypes": ["delta"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#receiver-method-declaration" },
    { "include": "#function-declaration" },
    { "include": "#type-declaration" },
    { "include": "#reference-type" },
    { "include": "#fallible-return-type" },
    { "include": "#as-result" },
    { "include": "#type-annotation" },
    { "include": "#keywords" },
    { "include": "#booleans" },
    { "include": "#function-call" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.delta",
          "match": "//.*$"
        },
        {
          "name": "comment.block.delta",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.delta",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.delta",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|[0nrt\\\\\"'])"
            }
          ]
        },
        {
          "name": "string.quoted.single.delta",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.delta",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|[0nrt\\\\\"'])"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.delta",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.delta",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.delta",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.delta",
          "match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.delta",
          "match": "\\b(import|export|from)\\b"
        },
        {
          "name": "keyword.control.delta",
          "match": "\\b(if|else|while|for|switch|case|default|break|continue|return|check|forward)\\b"
        },
        {
          "name": "storage.type.delta",
          "match": "\\b(function|const|let|type|unique|edit)\\b"
        },
        {
          "name": "keyword.operator.new.delta",
          "match": "\\b(new|heap)\\b"
        },
        {
          "name": "keyword.operator.delta",
          "match": "\\b(as|error|move|clone)\\b"
        }
      ]
    },
    "booleans": {
      "name": "constant.language.boolean.delta",
      "match": "\\b(true|false)\\b"
    },
    "function-declaration": {
      "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.delta" },
        "2": { "name": "entity.name.function.delta" }
      }
    },
    "receiver-method-declaration": {
      "match": "\\b(function)\\s*(\\()\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(?:(edit)\\s*)?(&)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(\\))\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.delta" },
        "3": { "name": "variable.parameter.delta" },
        "4": { "name": "punctuation.separator.key-value.delta" },
        "5": { "name": "storage.type.delta" },
        "6": { "name": "keyword.operator.delta" },
        "7": { "name": "entity.name.type.delta" },
        "9": { "name": "entity.name.function.delta" }
      }
    },
    "type-declaration": {
      "match": "\\b(?:(unique)\\s+)?(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.delta" },
        "2": { "name": "storage.type.delta" },
        "3": { "name": "entity.name.type.delta" }
      }
    },
    "reference-type": {
      "name": "storage.type.reference.delta",
      "match": "(?:(\\bedit\\b)\\s+)?(&)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.delta" },
        "2": { "name": "keyword.operator.delta" },
        "3": { "name": "entity.name.type.delta" }
      }
    },
    "fallible-return-type": {
      "match": "(\\|)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.operator.delta" },
        "2": { "name": "entity.name.type.delta" }
      }
    },
    "as-result": {
      "match": "\\b(as)\\s+(result)\\b",
      "captures": {
        "1": { "name": "keyword.operator.delta" },
        "2": { "name": "variable.other.delta" }
      }
    },
    "type-annotation": {
      "match": ":\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.type.delta" }
      }
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.delta" }
      }
    },
    "identifiers": {
      "name": "variable.other.delta",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
